{
  "dart.lineLength": 80,
  "files.insertFinalNewline": true,
  "java.configuration.updateBuildConfiguration": "interactive",
  "cmake.configureOnOpen": false,
  "search.exclude": {
    "**/.fvm": true,
    "**/.pub": true,
    "**/.dart_tool": true,
    "**/.idea": true,
    "**/.firebase": true,
    "**/build": true,
    "**/ios": true,
    "**/android": true,
    "**/macos": true,
    "**/web": true,
    "**/coverage": true,
    "**/packages/neon": true
  },
  "files.watcherExclude": {
    "**/.fvm": true,
    "**/.pub": true,
    "**/.dart_tool": true,
    "**/.firebase": true,
    "**/build": true,
    "**/ios": true,
    "**/android": true,
    "**/macos": true,
    "**/web": true,
    "**/coverage": true,
    "**/packages/neon": true
  },
  "dart.flutterSdkPath": ".fvm/versions/3.44.2",
  "dart.flutterRunAdditionalArgs": [
    "--dart-define-from-file=.env",
    "--dart-define-from-file=config/university.local.json"
  ],
  "dart.flutterTestAdditionalArgs": [
    "--dart-define-from-file=.env",
    "--dart-define-from-file=config/university.local.json"
  ]
}
