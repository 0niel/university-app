APP_ORGANIZATION_ID=your-organization-id
# Legacy built-in MIREA profile. Do not enable together with OFFICIAL_NEWS_ENABLED.
MIREA_ENABLED=false
# Generic official university news source.
OFFICIAL_NEWS_ENABLED=false
OFFICIAL_NEWS_URL=https://university.example/news/
OFFICIAL_NEWS_SOURCE_ID=official
OFFICIAL_NEWS_SOURCE_NAME=Example University
OFFICIAL_NEWS_CATEGORY=university
OFFICIAL_NEWS_LINK_SELECTOR=a[href*="/news/"]
OFFICIAL_NEWS_ARTICLE_SELECTORS=article,.news-detail,.detail-text,main [class*='content'],main
# JSON array of generic code connectors. Use self-hosted n8n for no-code APIs.
CONTENT_SOURCES=[]
# Public JSON API source example. Keep authenticated APIs in n8n credentials.
# CONTENT_SOURCES=[{"id":"public-api","provider":"json","name":"Example University","source_url":"https://university.example/news","feed_url":"https://api.university.example/news","metadata":{"items_path":"data.items","id_path":"id","title_path":"title","url_path":"url","published_at_path":"published_at","summary_path":"summary"}}]
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_INGEST_KEY=generate-a-dedicated-ingest-secret
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_CHANNELS=
TELEGRAM_STORY_CHANNELS=
TELEGRAM_BATCH_SIZE=30
TELEGRAM_BOOTSTRAP_LIMIT=30
TELEGRAM_MAX_ITEMS_PER_CYCLE=300
TELEGRAM_RECONCILE_MESSAGES=10
SYNC_INTERVAL_MINUTES=30
HEALTH_MAX_AGE_SECONDS=3660
